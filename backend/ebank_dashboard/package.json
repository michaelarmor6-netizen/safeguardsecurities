{
  "name": "bank_dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "NODE_ENV=production tsc -b && vite build --mode production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "type-check": "tsc -b --noEmit",
    "clean": "rimraf dist",
    "analyze": "npx vite-bundle-analyzer",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:functions:accounts": "firebase deploy --only functions:accounts",
    "deploy:functions:market": "firebase deploy --only functions:market",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run\"",
    "test": "npm run test:rules --prefix . && npm --prefix functions-trading run test",
    "emulators": "npm --prefix functions-trading run build && firebase emulators:start --only auth,firestore,functions,storage --import .emulator-data --export-on-exit .emulator-data",
    "emulators:fresh": "npm --prefix functions-trading run build && firebase emulators:start --only auth,firestore,functions,storage",
    "seed": "node functions-trading/scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.17.2",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.5.0",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.11",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.552.0",
    "postcss": "^8.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.66.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.18",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-admin": "^14.2.0",
    "globals": "^16.4.0",
    "terser": "^5.44.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.9"
  }
}
