# ============================================================
# ebank_dashboard - environment reference
#
# Two different mechanisms are documented here, don't confuse them:
#
# 1. Frontend (Vite) vars below - copy this section into a real `.env`
#    file at the project root. These ship into the client bundle, so
#    never put a real secret in a VITE_* var - anything here is public.
#
# 2. Cloud Functions secrets (bottom of this file) - these are NOT
#    read from a .env file at all. They live in Google Secret Manager
#    and are set once via `firebase functions:secrets:set <NAME>`,
#    which prompts for the value interactively. Listed here only as a
#    reference for which secrets each functions codebase needs.
# ============================================================

# ---- Firebase (client SDK config - public, not secret) ----
# From Firebase Console -> Project settings -> General -> Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- App mode ----
# 'safeguard' renders SafeguardApp.tsx (investor platform). Any other
# value (or unset) renders the bank dashboard App.tsx instead.
VITE_APP_MODE=safeguard
VITE_APP_NAME=SafeGuard Securities
VITE_COMPANY_NAME=SafeGuard Securities, Inc.

# ---- Live market quotes (optional override) ----
# Client-side fallback quote lookup in src/services/investor/marketService.ts.
# Falls back to a working demo key already hardcoded there if unset - only
# set this if you have your own Finnhub key and want to use it instead.
VITE_FINNHUB_API_KEY=

# ---- Dev/runtime flags ----
VITE_ENABLE_FIREBASE_EMULATORS=false
VITE_DEBUG_MODE=false
VITE_ENFORCE_HTTPS=true
VITE_SESSION_TIMEOUT_MINUTES=30


# ============================================================
# Cloud Functions secrets (set via `firebase functions:secrets:set NAME`,
# NOT via any .env file - listed here purely for reference)
# ============================================================

# ---- functions/ (codebase "default") ----
# IG market-data proxy. None of these have ever been provisioned, so this
# codebase cannot currently deploy at all (blocks on the first missing
# secret). Only needed if the IG live-chart panel is being revived.
#
# Fill these in here as a scratch pad only - then push each one with
# `firebase functions:secrets:set NAME`, which prompts for the value
# (or pipe a file in via --data-file to avoid a stray trailing newline
# corrupting the secret - a real issue hit with FINNHUB_API_KEY).
# Never commit this file with real values filled in.
#   IG_API_KEY=
#   IG_USERNAME=
#   IG_PASSWORD=
#   IG_ACCOUNT_TYPE=          (demo or live)

# ---- functions-accounts/ (codebase "accounts") ----
# Admin-initiated investor account creation. No secrets required - uses
# only the Admin SDK's default service account credentials.

# ---- functions-market/ (codebase "market") ----
# AI Engine signal generation + Market News + Research tabs.
#   FINNHUB_API_KEY        Can reuse the same key as VITE_FINNHUB_API_KEY
#                          above - it's already public in the client bundle.
#   ANTHROPIC_API_KEY      From https://console.anthropic.com/settings/keys
